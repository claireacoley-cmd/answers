# Copy to .env for local dev (netlify dev loads it). In production set these in
# Netlify → Site configuration → Environment variables.

# Password for /write (choose something long)
WRITE_PASSWORD=change-me

# Random secret used to sign login cookies (any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Anthropic API key for suggestions (subheads, FAQ questions, TL;DR, meta)
ANTHROPIC_API_KEY=
# Optional: model to use for suggestions
ANTHROPIC_MODEL=claude-sonnet-4-5

# Public URL of the site (no trailing slash)
SITE_URL=https://clairecoley.com

# IndexNow key: any 8-128 char hex/alphanumeric string. Bing/Yandex etc. verify it at
# /answers/indexnow-<key>.txt which this app serves automatically.
INDEXNOW_KEY=
